---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <div id="top">
    <Nav />

    <main class="mx-auto max-w-6xl px-6 sm:px-10 lg:px-16">
      <Hero />

      <SelectedWork />
      <Services />

      <section id="about" class="border-t border-border py-20 sm:py-28" aria-labelledby="about-title">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">About</p>
        <h2 id="about-title" class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">About Jesse</h2>
      </section>

      <section id="contact" class="border-t border-border py-20 sm:py-28" aria-labelledby="contact-title">
        <p class="text-sm font-medium uppercase tracking-[0.18em] text-accent">Contact</p>
        <h2 id="contact-title" class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">Let’s work together.</h2>
        <a class="mt-8 inline-block text-lg underline decoration-border underline-offset-8 transition-colors hover:decoration-foreground" href="mailto:hello@jesse-salinas.com?subject=UGC inquiry for Jesse">hello@jesse-salinas.com</a>
      </section>
    </main>

    <Footer />
  </div>
</Base>
