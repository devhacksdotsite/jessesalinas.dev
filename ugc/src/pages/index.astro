---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---

<Base>
  <main class="mx-auto max-w-6xl px-6 py-12 sm:px-10 lg:px-16">
    <header class="flex items-center justify-between border-b border-border pb-6">
      <a href="/" class="text-sm font-semibold uppercase tracking-[0.18em]">Jesse Salinas</a>
      <span class="text-sm text-muted">UGC Portfolio</span>
    </header>

    <section class="py-24 sm:py-32" aria-labelledby="page-title">
      <p class="mb-5 text-sm font-medium uppercase tracking-[0.18em] text-accent">Tech & Software UGC Creator</p>
      <h1 id="page-title" class="max-w-3xl text-5xl font-semibold tracking-tight sm:text-7xl">
        Short-form content for technology brands.
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-8 text-muted">
        A standalone portfolio for SaaS, AI, apps, and consumer technology.
      </p>
    </section>

    <section id="work" aria-labelledby="work-title" class="border-t border-border py-20">
      <h2 id="work-title" class="text-3xl font-semibold">Selected Work</h2>
      {projects.length === 0 ? (
        <p class="mt-6 max-w-xl text-muted">
          Portfolio videos will appear here as they are added to the project data file.
        </p>
      ) : (
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <article>
              <video class="aspect-[9/16] w-full object-cover" controls preload="none" poster={project.poster} aria-label={project.alt}>
                <source src={project.video} type="video/mp4" />
              </video>
              <h3 class="mt-4 font-medium">{project.title}</h3>
              <p class="mt-1 text-sm text-muted">{project.category}</p>
            </article>
          ))}
        </div>
      )}
    </section>
  </main>
</Base>
